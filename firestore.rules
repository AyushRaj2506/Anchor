rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Scopes all access rules to the specific userId.
    // Ensure that User A cannot read or write User B's documents/subcollections.
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // Resources subcollection rules
      match /resources/{resourceId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Tasks subcollection rules
      match /tasks/{taskId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
  }
}
