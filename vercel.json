{
  "framework": "vite",
  "functions": {
    "api/ai/*.js": {
      "maxDuration": 120
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ],
  "build": {
    "env": {
      "VITE_SUPABASE_URL": "https://gmsmwoyrrfrwqtiqtffc.supabase.co",
      "VITE_SUPABASE_ANON_KEY": "sb_publishable_Mm_xtsdZzrxAap0f1ORpMQ_bnJZSh0n"
    }
  }
}
