rules_version = '2';

// Craft rules based on the provided project structure and security requirements
service firebase.storage {
  match /b/{bucket}/o {
    // Only allow access if the user is authenticated and is accessing their own folder
    match /{userId}/{allPaths=**} {
      allow read: if request.auth != null && request.auth.uid == userId;

      // Legacy Firebase Storage uploads use the same limits as Supabase uploads.
      allow create, update: if request.auth != null
                   && request.auth.uid == userId
                   && request.resource.size > 0
                   && request.resource.size <= 20 * 1024 * 1024
                   && request.resource.contentType in ['application/pdf', 'image/jpeg', 'image/png', 'image/webp'];
      allow delete: if request.auth != null && request.auth.uid == userId;
    }
  }
}
